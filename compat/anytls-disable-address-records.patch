diff --git a/internal/certmgr/no_publish_test.go b/internal/certmgr/no_publish_test.go
new file mode 100644
index 0000000..1de8676
--- /dev/null
+++ b/internal/certmgr/no_publish_test.go
@@ -0,0 +1,26 @@
+package certmgr
+
+import (
+	"context"
+	"testing"
+)
+
+func TestDisabledAddressPublishingRetainsACME(t *testing.T) {
+	c := testConfig(t)
+	disabled := false
+	c.PublishAddressRecords = &disabled
+	f := newACMEFixture(t, c.Domain)
+	m := f.manager(t, c)
+	if err := m.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	defer m.Close()
+	if err := m.renew(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.orders != 2 || f.a.Content != "" || len(f.txt) != 0 || f.deleted != 2 {
+		t.Fatalf("orders=%d A=%v TXT=%v deleted=%d", f.orders, f.a, f.txt, f.deleted)
+	}
+}
